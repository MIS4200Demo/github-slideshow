SELECT tmpTax.InvoiceNumber ,
       c.NameOf AS 'InsuredName' ,
       p.policyNumber AS 'Policy#' ,
       pldesc.ResourceText AS 'LineOfBusiness' ,
       th.Code AS 'Class' ,
       tmptax.TAXPrintDate AS 'GenerateInvoiceDate' ,
       th.EffectiveDate AS 'TransactionEffectiveDate' ,
       p.ExpirationDate AS 'PolicyExpiationDate' ,
       CASE th.UniqTransheadReversal
           WHEN - 1 THEN ' '
           ELSE '`'
       END AS 'Status_Void_or_Valid' ,
       td.ItemAmount AS 'TransactionAmount' ,
       tmptax.FEEF AS 'FEEF_FulluyEarnedFee' ,
       tmptax.CFEE AS 'CFEE_CompanyFee' ,
       tmptax.AFEE AS 'AFEE_AgencyFee' ,
       tmptax.IFEE AS 'IFEE_InspectionFee' ,
       tmptax.AFNC AS 'AFNC_McGowanFee' ,
       tmpTax.SLTX ,
       tmptax.SSTX ,
       l.EntityKeyBillTo ,
       CASE l.EntityKeyBillTo
           WHEN 'BROK' THEN br.NameOf
           WHEN 'CUST' THEN cl.NameOf
       END 'Producing_Retail_Broker' ,
           bico.NameOf AS 'BillingCompany' ,
           isco.NameOf AS 'IssuingCompany' ,
           l.CdStateCodeIssuing AS 'Tax_Contract_State' ,
           TaxFiler = ISNULL(sup.TaxFiler, cf.TaxFiler) ,
           ca.Address1 ,
           ca.Address2 ,
           ca.Address3 ,
           ca.City ,
           ca.CdStateCode AS 'State' ,
           ca.PostalCode AS 'Zip' ,
           l.RisksDescription AS 'DescriptionOfInsured' ,
           a.AgencyCode AS 'BillingStructure' ,
           b.BranchCode AS 'BranchCode' ,
           TaxStatus = ISNULL(sup.TaxStatus, cf.TaxStatus) ,
           CASE
               WHEN p.flags & 8 = 8
                    OR MultiIssu.IssCount > 1 THEN 'Yes'
               ELSE 'No'
           END AS 'MultiCarrier' ,
           l.EstimatedPremium AS 'Line Estimated Premium'
FROM client c
JOIN Policy p ON c.UniqEntity = p.UniqEntity
JOIN
  (SELECT DISTINCT p.uniqpolicy,
                   count(uniqentitycompanyissuing) AS IssCount
   FROM policy p
   JOIN LINE l ON p.UniqPolicy = l.UniqPolicy
   GROUP BY p.UniqPolicy) MultiIssu ON p.UniqPolicy = MultiIssu.UniqPolicy
JOIN
  (SELECT ISNUll(th.InvoiceNumber, -1) AS InvoiceNumber ,
          th.uniqpolicy ,
          TAXPrintDate = MAX(CASE
                                 WHEN th.code IN ('SLTX' , 'SSTX') THEN td.PrintDate
                                 ELSE '01-01-1900'
                             END) ,
          FEEF = sum(CASE
                         WHEN th.code = 'FEEF' THEN td.itemamount
                         WHEN th.code = 'XSVC' THEN td.itemamount
                         ELSE 0
                     END) ,
          CFEE = sum(CASE
                         WHEN th.code = 'CFEE' THEN td.itemamount
                         ELSE 0
                     END) ,
          AFEE = sum(CASE
                         WHEN th.code = 'AFEE' THEN td.itemamount
                         ELSE 0
                     END) ,
          IFEE = sum(CASE
                         WHEN th.code = 'IFEE' THEN td.itemamount
                         ELSE 0
                     END) ,
          AFNC = sum(CASE
                         WHEN th.code = 'AFNC' THEN td.itemamount
                         ELSE 0
                     END) ,
          SLTX = sum(CASE
                         WHEN th.code = 'SLTX' THEN td.itemamount
                         ELSE 0
                     END) ,
          SSTX = sum(CASE
                         WHEN th.code = 'SSTX' THEN td.itemamount
                         ELSE 0
                     END)
   FROM transhead th
   JOIN TransDetail td ON th.UniqTransHead = td.uniqtranshead
   WHERE td.ProcessCode = 'ORIG'
     AND td.TransDetailNumber = 1
     AND td.ClassCode IN ('TXAC',
                          'TXDB',
                          'FEES',
                          'FEAC')--and th.InvoiceNumber = 5706--,'FEDB')--,'APPL')

   GROUP BY th.InvoiceNumber,
            th.UniqPolicy) tmpTax ON p.UniqPolicy = tmpTax.UniqPolicy
LEFT JOIN Transhead th ON isnull(nullif(th.InvoiceNumber, ''), -1) = isnull(nullif(tmpTax.InvoiceNumber, ''), -1)
AND th.UniqPolicy = tmpTax.UniqPolicy
AND th.code IN ('NEWB' ,
                'RENB' ,
                '+END' ,
                '-END' ,
                'AUDI' ,
                'CANC' ,
                'REWR' ,
                'INST' ,
                'REIN')
LEFT JOIN TransDetail td ON th.UniqTransHead = td.uniqtranshead
AND td.TransDetailNumber =1
JOIN LINE l ON p.UniqPolicy = l.UniqPolicy
JOIN
  (SELECT li.uniqline ,
          max(li.UniqLineImage) AS uniqlineimage
   FROM lineimage li
   GROUP BY li.uniqline) maxli ON l.uniqline = maxli.UniqLine
JOIN CdPolicyLineType cdpl ON l.UniqCdPolicyLineType = cdpl.UniqCdPolicyLineType
JOIN ConfigureLkLanguageResource pldesc ON cdpl.ConfigureLkLanguageResourceID = pldesc.ConfigureLkLanguageResourceID
AND pldesc.CultureCode = 'en-US'
JOIN Agency a ON p.UniqAgency = a.UniqAgency
JOIN Branch b ON p.UniqBranch = b.UniqBranch
LEFT JOIN broker br ON l.UniqEntityBillTo = br.UniqEntity
AND l.EntityKeyBillTo = 'BROK'
LEFT JOIN Client cl ON l.UniqEntityBillTo = cl.UniqEntity
AND l.EntityKeyBillTo = 'CUST'
JOIN Company isco ON l.UniqEntityCompanyIssuing = isco.UniqEntity
JOIN Company bico ON l.UniqEntityCompanyBilling = bico.UniqEntity
JOIN ContactAddress ca ON c.UniqContactAddressAccount = ca.UniqContactAddress
LEFT JOIN #tmpSupp sup ON sup.uniqlineimage = maxli.uniqlineimage
LEFT JOIN #tmpcf Cf ON cf.uniqlineImage = Maxli.uniqlineImage
WHERE (tmpTax.SLTX <> 0
       OR tmpTax.SSTX <> 0)--and l.CdStateCodeIssuing = 'CA'
--and tmptax.TaxPrintDate between '2018-007-01 00:00:00.000' and '2018-07-31 00:00:00.000'
ORDER BY tmptax.InvoiceNumber
